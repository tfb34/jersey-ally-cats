---
import SiteLayout from "../layouts/SiteLayout.astro";

import { sanityClient } from "sanity:client";

const aboutPage = await sanityClient.fetch(`*[_type == "aboutPage"][0]{
  intro{
    ...,
    "imageUrl": image.asset->url
  },
  ourWork{
    primaryWork{
      ...,
      "imageUrl": image.asset->url
    },
    secondaryWork{
      ...,
      "imageUrl": image.asset->url
    }
  },
  vision{
      ...,
       "imageUrl": image.asset->url
    }
}`);
---

<SiteLayout title="About">
  <!--Row 1 -->
  <section class="flex flex-col md:flex-row lg:min-h-[600px]">
    <!--LEFT: Astro image used a CSS background -->
    <div
      style={`background-image: url("${aboutPage.intro.imageUrl}")`}
      class="bg-cover bg-center lg:bg-position-[center_top_20%] w-full md:w-1/2 h-[400px] md:h-auto"
    >
    </div>
    <!--RIGHT: Mission -->
    <div class="bg-brand-primary w-full md:w-1/2 items-center flex py-16 px-6">
      <div class="lg:max-w-[500px] mx-auto">
        <h1 class="mb-10 text-brand-soft text-3xl lg:text-5xl">
          {aboutPage.intro.heading}
        </h1>
        <p class="text-white whitespace-pre-line">
          {aboutPage.intro.text}
        </p>
      </div>
    </div>
  </section>
  <!--Row 2 -->
  <section class="flex flex-col md:flex-row min-h-[600px]">
    <!--LEFT: Street Rescue -->
    <div
      class="bg-brand-soft w-full md:w-1/2 items-center flex flex-col py-16 px-6"
    >
      <div
        class="w-60 h-60 bg-pink-500 rounded-[100%] mb-10 bg-cover bg-center"
        style={`background-image: url("${aboutPage.ourWork.primaryWork.imageUrl}")`}
      >
      </div>
      <div class="lg:max-w-[500px] mx-auto">
        <h1 class="mb-10 text-brand-primary text-3xl lg:text-5xl">
          {aboutPage.ourWork.primaryWork.heading}
        </h1>
        <p>
          {aboutPage.ourWork.primaryWork.text}
        </p>
      </div>
    </div>

    <!--RIGHT: Complex Medical Cases -->
    <div
      class="bg-brand-surface w-full md:w-1/2 items-center flex flex-col py-16 px-6"
    >
      <div
        class="w-60 h-60 bg-pink-500 rounded-[100%] mb-10 bg-cover bg-center"
        style={`background-image: url("${aboutPage.ourWork.secondaryWork.imageUrl}")`}
      >
      </div>
      <div class="lg:max-w-[500px] mx-auto">
        <h1 class="mb-10 text-3xl lg:text-5xl">
          {aboutPage.ourWork.secondaryWork.heading}
        </h1>
        <p>
          {aboutPage.ourWork.secondaryWork.text}
        </p>
        <details class="group">
          <summary
            class="cursor-pointer list-none text-link hover:underline font-bold"
          >
            <span class="group-open:hidden">Read more &rarr;</span>
            <span class="hidden group-open:inline">Read less</span>
          </summary>

          <p>
            Numquam qui fugiat ut facilis excepturi officiis quae deleniti
            distinctio est voluptatum soluta tenetur, assumenda illum eaque
            dolore, sint porro, dolorum error illo. Voluptate, praesentium dolor
            nobis at reprehenderit explicabo facilis perferendis ex porro illum,
            veritatis aspernatur illo quo quod laboriosam architecto molestias
            eius repudiandae voluptates sint accusantium alias eligendi?
            Sapiente optio dolore animi veniam vitae consectetur fugit magnam
            totam rem corrupti saepe modi atque amet quae reiciendis mollitia
            error quam incidunt beatae doloribus voluptatibus odit quia,
            perferendis autem. Magni mollitia ex, tenetur inventore ducimus
            nobis quaerat vitae, illum animi eius impedit delectus sint sed
            voluptates iste ipsa praesentium ad ab quas. Maiores dignissimos
            odio porro cupiditate animi amet illo odit quisquam voluptates. Nisi
            quae ea iure animi ad id deleniti vitae dolore voluptatem, modi
            molestias quaerat qui, rem saepe laborum officia quidem tempora odio
            distinctio architecto totam delectus?
          </p>
        </details>
      </div>
    </div>
  </section>
  <!--Row 3 -->
  <section class="flex flex-col md:flex-row min-h-[500px]">
    <!--LEFT: Astro image used a CSS background -->
    <div
      style={`background-image: url("${aboutPage.vision.imageUrl}")`}
      class="bg-cover bg-center w-full md:w-1/2 h-[400px] md:h-auto"
    >
    </div>
    <!--RIGHT: Mission -->
    <div class="bg-brand-primary w-full md:w-1/2 items-center flex py-16 px-6">
      <div class="lg:max-w-[500px] mx-auto">
        <h1 class="mb-10 text-brand-soft text-3xl lg:text-5xl">
          {aboutPage.vision.heading}
        </h1>
        <p class="text-white whitespace-pre-line">
          {aboutPage.vision.text}
        </p>
      </div>
    </div>
  </section>
</SiteLayout>

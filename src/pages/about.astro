---
import SiteLayout from "../layouts/SiteLayout.astro";
import velvetImage from "../images/velvetImage.jpg";
import BellaImage from "../images/bella.jpeg";
import JohnnyImage from "../images/johnny.jpeg";
import JoyImage from "../images/joy.jpeg";

import { sanityClient } from "sanity:client";

const aboutPage = await sanityClient.fetch(`*[_type == "aboutPage"][0]{
  intro{
    ...,
    "imageUrl": image.asset->url
  }
}`);
---

<SiteLayout title="About">
  <!--Row 1 -->
  <section class="flex flex-col md:flex-row min-h-[600px]">
    <!--LEFT: Astro image used a CSS background -->
    <div
      style={`background-image: url("${aboutPage.intro.imageUrl}")`}
      class="bg-cover bg-center lg:bg-position-[center_top_20%] w-full md:w-1/2 h-[400px] md:h-auto"
    >
    </div>
    <!--RIGHT: Mission -->
    <div class="bg-brand-primary w-full md:w-1/2 items-center flex p-16">
      <div>
        <h1 class="mb-10 text-brand-soft text-section-title">Our Mission</h1>
        <p class="text-white">
          {aboutPage.intro.text}
        </p>
      </div>
    </div>
  </section>
  <!--Row 2 -->
  <section class="flex flex-col md:flex-row min-h-[600px]">
    <!--LEFT: Street Rescue -->
    <div class="bg-brand-soft w-full md:w-1/2 items-center flex flex-col p-16">
      <div
        class="w-60 h-60 bg-pink-500 rounded-[100%] mb-10 bg-cover bg-center"
        style={`background-image: url("${JohnnyImage.src}")`}
      >
      </div>
      <div class="h-[200px]">
        <h1 class="mb-10 text-brand-primary text-section-title">
          Street Rescue
        </h1>
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Labore odit
          commodi similique libero laudantium repellat odio perferendis ratione!

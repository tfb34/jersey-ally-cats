  </section>
  <!--Row 3 -->
  <section class="flex flex-col md:flex-row min-h-[500px]">
    <!--LEFT: Astro image used a CSS background -->
    <div
      style={`background-image: url("${BellaImage.src}")`}
      class="bg-cover bg-center w-full md:w-1/2 h-[400px] md:h-auto"
    >
    </div>
    <!--RIGHT: Mission -->
    <div class="bg-brand-primary w-full md:w-1/2 items-center flex p-16">
      <div>
        <h1 class="mb-10 text-brand-soft text-section-title">Our Vision</h1>
        <p class="text-white">
          Purrfect Catpanion is a 501(c)(3) non-profit organization founded by
          women with a mission to make the adoption process smoother and easier
          for both cats and adopters. Our core purpose is to reduce the
          population and suffering of street cats by rescuing all friendlies
          from our local communities, providing them with veterinary care,
          socialization as needed, and ultimately finding them loving forever
          homes.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>

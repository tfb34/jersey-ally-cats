---
import SiteLayout from "../layouts/SiteLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import IconListItem from "../components/IconListItem.astro";

import mapIcon from "../images/icons/location-bg-circle.png";
import instagramIcon from "../images/icons/instagram-bg-circle.png";
import mailIcon from "../images/icons/mail-bg-circle.png";
import greenCheckIcon from "../images/icons/green-check.png";
import { Image } from "astro:assets";

import { Resend } from "resend";

const success = Astro.url.searchParams.get("success") === "true";

const resend = new Resend(import.meta.env.RESEND_API_KEY);

export const prerender = false;

const errors = { name: "", email: "", subject: "", message: "" };

let values = {
  name: "",
  email: "",
  subject: "",
  message: "",
};

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();

    values.name = data.get("name")?.toString() ?? "";
    values.email = data.get("email")?.toString() ?? "";
    values.subject = data.get("subject")?.toString() ?? "";
    values.message = data.get("message")?.toString() ?? "";

    const name = data.get("name");
    const email = data.get("email");
    const subject = data.get("subject");
    const message = data.get("message");
    console.log(`${name} , ${email}, ${subject}, ${message}`);

    //validate
    if (typeof name !== "string" || name.length < 2) {
      errors.name += "Please enter a valid name.";
    }
    if (typeof email !== "string") {
      errors.email += "Email is not valid.";
    }
    if (typeof subject !== "string" || subject.length < 3) {
      errors.subject += "Must be at least 3 characters.";
    }
    if (typeof message !== "string" || message.length < 32) {
      errors.message += "Message must be at least 32 characters.";
    }

    const hasErrors = Object.values(errors).some((msg) => msg);
    console.log(hasErrors);
    if (!hasErrors) {
      //send email to client with RESEND API
      await resend.emails.send({
        from: "onboarding@resend.dev",
        to: "britothalia212@gmail.com",
        replyTo: email as string,
        subject: `Website Inquiry: ${subject}`,
        text: `Name: ${name} Email: ${email} ${message}`,
      });
      values = {
        name: "",
        email: "",
        subject: "",
        message: "",
      };
      return Astro.redirect("/contact?success=true");
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}
---

<SiteLayout>
  <section class="wallpaper">
    <Container>
      <div class="md:grid md:grid-cols-5">
        <div class="col-span-2">
          <PageHeader
            title="Contact Us"
            headline="We're here to help"
            description="Have a question, want to get involved, or just want to say hi? We'd love to hear from you! Fill out the form or reach us directly using the information below."
          />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-6">
    <Container class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="">
        <h2 class="font-semibold font-heading text-4xl text-brand-primary mb-4">
          Send us a message
        </h2>
        {
          success && (
            <div
              role="status"
              class="bg-green-50 border border-green-200 rounded-lg py-6 px-4 flex gap-6"
            >
              <Image
                src={greenCheckIcon}
                alt="success check icon"
                class="h-10 w-10"
              />
              <div>
                <h2 class="font-heading text-2xl font-semibold">
                  Message sent!
                </h2>
                <p class="text-md/7">
                  Thanks for reaching out. We'll be in touch soon.
                </p>
                <p class="text-sm/5 mt-3">
                  In the meantime, feel free to explore our site or follow us on
                  Instagram for the latest updates.
                </p>
              </div>
            </div>
          )
        }
        <form class="" method="POST">
          <div class="form-group mb-4">
            <label for="name" class="font-semibold text-md/7"> Your name</label>
            <input
              type="text"
              name="name"
              id="name"
              required
              value={values.name}
              class="px-4 py-2 text-base block border border-gray-400 rounded mt-2 w-full"
            />
            {errors.name && <p class="text-pink-600 text-sm">{errors.name}</p>}
          </div>

          <div class="form-group mb-4">
            <label for="email" class="font-semibold text-md/7">Your Email</label
            >
            <input
              type="email"
              name="email"
              id="email"
              required
              value={values.email}
              class="px-4 py-2 text-base block border border-gray-400 rounded mt-2 w-full"
            />
            {
              errors.email && (
                <p class="text-pink-600 text-sm">{errors.email}</p>
              )
            }
          </div>

          <div class="form-group mb-4">
            <label for="subject" class="font-semibold text-md/7">
              Subject
            </label>
            <input
              type="text"
              name="subject"
              id="subject"
              required
              value={values.subject}
              class="px-4 py-2 text-base block border border-gray-400 rounded mt-2 w-full"
            />
            {
              errors.subject && (
                <p class="text-pink-600 text-sm">{errors.subject}</p>
              )
            }
          </div>

          <div class="form-group mb-10">
            <label for="subject" class="font-semibold text-md/7"
              >Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              cols="50"
              required
              class="px-4 py-2 text-base block border border-gray-400 rounded mt-2 w-full"
              placeholder="Tell us more...">{values.message}</textarea
            >
            {
              errors.message && (
                <p class="text-pink-600 text-sm">{errors.message}</p>
              )
            }
          </div>

          <button
            class="rounded-full px-8 py-2.5 text-sm font-semibold shadow-xs mt-3 md:mt-0 text-center bg-action-primary text-white hover:bg-action-primary-hover"
            >Send message →</button
          >
        </form>
      </div>
      <div>
        <div class="p-8 rounded-2xl">
          <h3 class="font-heading font-semibold text-2xl mb-4">
            Other ways to reach us
          </h3>
          <ul class="space-y-8">
            <IconListItem icon={mailIcon} title="Email" description=""
              ><a href="mailto:hello@jerseyalleycats.org" class="font-semibold"
                >hello@jerseyalleycats.org</a
              ><p>
                We typically respond within 1-2 business days.
              </p></IconListItem
            >
            <IconListItem icon={instagramIcon} title="Instagram" description=""
              ><a href="#">@jerseyallycats</a></IconListItem
            >
            <IconListItem icon={mapIcon} title="Our service area" description=""
              ><p>
                Jersey City, Union City, Weehawken and surrounding Hudson County
                communities.
              </p></IconListItem
            >
          </ul>
        </div>
      </div>
    </Container>
  </section>
</SiteLayout>

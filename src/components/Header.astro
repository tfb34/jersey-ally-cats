---
import { Image } from "astro:assets";
import logo from "../images/logo-dark.png";

import { sanityClient } from "sanity:client";

const navigation = await sanityClient.fetch(`*[_type == "aboutPage"][0]{
  intro{
    ...,
    "imageUrl": image.asset->url
  }
}`);
---

<header class="bg-brand-surface">
  <!--landmark-->
  <nav
    class="px-6 lg:px-8 py-2 w-full shadow-md flex justify-between items-center"
  >
    <span><Image src={logo} alt="logo" class="h-16 w-auto" /></span>
    <!--Mobile Only-->
    <div class="mobile-menu md:hidden js-has-submenu" data-expanded="false">
      <!--Burger button-->
      <button
        type="button"
        class="absolute top-0 right-0 z-30 p-2 mx-6 mt-5 inline-flex items-center justify-center rounded-md text-gray-400 hover:bg-gray-100 focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-500"
        aria-expanded="false"
      >
        <span class="absolute -inset-0.5"></span>
        <span class="sr-only">Open main menu</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          data-slot="icon"
          aria-hidden="true"
          class="size-6 in-aria-expanded:hidden"
        >
          <path
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          data-slot="icon"
          aria-hidden="true"
          class="size-6 not-in-aria-expanded:hidden"
        >
          <path
            d="M6 18 18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <!--mobile menu -->
      <ul
        class="absolute w-full h-full top-0 right-0 bg-white p-6 space-y-2"
        aria-hidden="true"
      >
        <li class="mb-6">
          <span><Image src={logo} alt="logo" class="h-8 w-auto" /></span>
        </li>

        <li>
          <a
            href="/"
            class="text-base/7 font-semibold hover:bg-gray-100 block py-2 px-3 rounded-lg"
            >Home</a
          >
        </li>
        <li>
          <a
            href="/adopt"
            class="text-base/7 font-semibold hover:bg-gray-100 block py-2 px-3 rounded-lg"
            >Adopt</a
          >
        </li>
        <li>
          <details class="list-none group rounded-lg">
            <summary
              class="list-none text-base/7 py-2 px-3 text-gray-900 font-semibold flex rounded-lg hover:bg-gray-100"
            >
              Get Involved
              <span class="flex items-center">
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  data-slot="icon"
                  aria-hidden="true"
                  class="size-5 flex-none text-gray-400 group-open:rotate-180"
                >
                  <path
                    d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                    fill-rule="evenodd"></path>
                </svg>
              </span>
            </summary>
            <ul class="space-y-2">
              <li>
                <a
                  href="/foster"
                  class="block hover:bg-gray-100 text-sm/7 font-semibold text-gray-900 py-2 px-6 rounded-lg"
                  >Foster</a
                >
              </li>
              <li>
                <a
                  href="/volunteer"
                  class="block hover:bg-gray-100 text-sm/7 font-semibold text-gray-900 py-2 px-6 rounded-lg"
                  >Volunteer</a
                >
              </li>
              <li>
                <a
                  href="#"
                  class="block hover:bg-gray-100 text-sm/7 font-semibold text-gray-900 py-2 px-6 rounded-lg"
                  >TNR</a
                >
              </li>
              <li>
                <a
                  href="#"
                  class="block hover:bg-gray-100 text-sm/7 font-semibold text-gray-900 py-2 px-6 rounded-lg"
                  >Events</a
                >
              </li>
              <li>
                <a
                  href="#"
                  class="block hover:bg-gray-100 text-sm/7 font-semibold text-gray-900 py-2 px-6 rounded-lg"
                  >Fundraise</a
                >
              </li>
            </ul>
          </details>
        </li>
        <li>
          <a
            href="/about"
            class="text-base/7 font-semibold hover:bg-gray-100 block py-2 px-3 rounded-lg"
            >About</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class="text-base/7 font-semibold hover:bg-gray-100 block py-2 px-3 rounded-lg"
            >Contact</a
          >
        </li>
        <li>
          <a
            href="#"
            class="text-base/7 font-semibold hover:bg-gray-100 block py-2 px-3 rounded-lg"
            >Donate ♡</a
          >
        </li>
      </ul>
    </div>

    <!--Desktop Menu Only-->
    <ul class="mx-auto hidden md:flex flex-row relative items-center gap-x-12">
      <!--Dropdown-->
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><a href="/adopt" class="hover:underline">Adopt</a></li>
      <li class="dropdown js-has-submenu" data-expanded="false">
        <!--dataset.expanded-->
        <a href="#" class="hover:underline">Get Involved</a>
        <button aria-label="Submenu of Get Involved" aria-expanded="false">
          <!--aria-expanded-->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            style="transform: translateY(3px)"
            width="16px"
            height="16px"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M4.29289 8.29289C4.68342 7.90237 5.31658 7.90237 5.70711 8.29289L12 14.5858L18.2929 8.29289C18.6834 7.90237 19.3166 7.90237 19.7071 8.29289C20.0976 8.68342 20.0976 9.31658 19.7071 9.70711L12.7071 16.7071C12.3166 17.0976 11.6834 17.0976 11.2929 16.7071L4.29289 9.70711C3.90237 9.31658 3.90237 8.68342 4.29289 8.29289Z"
              fill="#000000"></path>
          </svg>
        </button>
        <!--submenu-->
        <ul
          class="w-[250px] bg-white absolute shadow-xl/30 rounded-lg p-4 space-y-2 inset-shadow-2xs"
          aria-hidden="true"
        >
          <li>
            <a
              href="/foster"
              class="py-2 px-4 hover:bg-gray-100 focus:bg-gray-200 block rounded-lg"
              >Foster</a
            >
          </li>
          <li>
            <a
              href="/volunteer"
              class="py-2 px-4 hover:bg-gray-100 focus:bg-gray-200 block rounded-lg"
              >Volunteer</a
            >
          </li>
          <li>
            <a
              href="/tnr"
              class="py-2 px-4 hover:bg-gray-100 focus:bg-gray-200 block rounded-lg"
              >TNR</a
            >
          </li>
          <li>
            <a
              href="#"
              class="py-2 px-4 hover:bg-gray-100 focus:bg-gray-200 block rounded-lg"
              >Events</a
            >
          </li>
          <li>
            <a
              href="#"
              class="py-2 px-4 hover:bg-gray-100 focus:bg-gray-200 block rounded-lg"
              >Fundraise</a
            >
          </li>
        </ul>
      </li>
      <!--End of Dropdown-->
      <li><a href="/about" class="hover:underline">About</a></li>
      <li><a href="/contact" class="hover:underline">Contact</a></li>
      <li><a href="#" class="hover:underline">Donate ♡</a></li>
    </ul>
  </nav>
</header>

<script>
  const menuItems = document.querySelectorAll(".js-has-submenu");

  let expandedItem = null;

  const expandSubMenu = (item) => {
    const subMenu = item.querySelector("ul");
    const button = item.querySelector("button");
    expandedItem = item;

    subMenu.setAttribute("aria-hidden", "false");
    button.setAttribute("aria-expanded", "true");
    item.dataset.expanded = "true";
  };

  const collapseSubMenu = (item) => {
    const subMenu = item.querySelector("ul");
    const button = item.querySelector("button");
    expandedItem = item;

    subMenu.setAttribute("aria-hidden", "true");
    button.setAttribute("aria-expanded", "false");
    item.dataset.expanded = "false";
  };

  menuItems.forEach((item) => {
    const button = item.querySelector("button");

    //KeyBoard Users
    button.addEventListener("click", (event) => {
      if (button.ariaExpanded === "false") {
        expandSubMenu(item);
      } else {
        collapseSubMenu(item);
      }
    });

    //Mouse Users
    if (!item.classList.contains("mobile-menu")) {
      item.addEventListener("mouseenter", () => {
        expandSubMenu(item);
      });

      item.addEventListener("mouseleave", () => {
        collapseSubMenu(item);
      });
    }
  });
</script>

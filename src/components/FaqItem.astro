---
interface Props {
  question: string;
  answer: string;
  class?: string;
}

const { question, answer, class: extraClasses } = Astro.props;
---

<details class:list={["list-none group px-5 lg:px-10", extraClasses]}>
  <summary
    class="text-lg/5 md:text-xl py-6 font-heading text-brand-primary font-semibold flex rounded-lg justify-between"
  >
    {question}
    <span class="flex items-center">
      <svg
        viewBox="0 0 20 20"
        fill="currentColor"
        data-slot="icon"
        aria-hidden="true"
        class="size-5 flex-none text-gray-400 group-open:rotate-180"
      >
        <path
          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
          clip-rule="evenodd"
          fill-rule="evenodd"></path>
      </svg>
    </span>
  </summary>
  <p class="text-base md:pr-30 pb-5">
    {answer}
  </p>
</details>

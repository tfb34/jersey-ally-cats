---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SvgComponent } from "astro/types";

interface Props {
  title: string;
  icon: ImageMetadata | SvgComponent;
}

const { title, icon } = Astro.props;

const isSvg = typeof icon == "function";
const Icon = isSvg ? icon : null;
---

<div class="text-center">
  <!-- <div class="h-20 w-20 bg-violet-500 mx-auto"></div> -->
  {
    Icon ? (
      <Icon class="h-20 w-auto mx-auto" aria-hidden="true" />
    ) : (
      <Image
        src={icon as ImageMetadata}
        alt={`${title} Icon`}
        class="h-20 w-auto mx-auto"
      />
    )
  }

  <h3 class="text-brand-primary font-semibold text-lg/7 font-heading pt-2">
    {title}
  </h3>
  <p class="text-base/7">
    <slot />
  </p>
</div>

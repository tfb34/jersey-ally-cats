---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  icon: ImageMetadata;
}

const { title, icon } = Astro.props;
---

<div class="text-center">
  <!-- <div class="h-20 w-20 bg-violet-500 mx-auto"></div> -->
  <Image src={icon} alt={`${title} Icon`} class="h-20 w-auto mx-auto" />
  <h3 class="text-brand-primary font-semibold text-lg/7 font-heading pt-2">
    {title}
  </h3>
  <p class="text-base/7">
    <slot />
  </p>
</div>

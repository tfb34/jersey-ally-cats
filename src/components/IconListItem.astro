---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  icon: ImageMetadata;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: extraClasses } = Astro.props;

// import Icon from "../images/icons/checkmark.png";
---

<li class:list={[extraClasses, "flex items-center gap-2 md:gap-5"]}>
  <div class="shrink-0">
    <Image
      src={icon}
      alt={`${title} Icon`}
      class="h-10 md:h-12 w-auto mx-auto"
    />
  </div>
  <div>
    <h4 class="text-lg font-heading text-brand-primary font-semibold">
      {title}
    </h4>
    <slot />
    <p class="text-base/7">{description}</p>
  </div>
</li>

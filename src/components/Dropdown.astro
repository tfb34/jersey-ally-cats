---
// Dropdown.astro
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="relative inline-block text-left astro-dropdown">
  <!-- Trigger Button -->
  <button
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    class="inline-flex items-center justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-600 transition-all"
  >
    {label}
    <svg
      class="-mr-1 h-5 w-5 text-gray-400 aria-expanded:rotate-180 transition-transform duration-200"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    role="menu"
    tabindex="-1"
    class="absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white p-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none transition-all scale-95 opacity-0 pointer-events-none data-[open]:scale-100 data-[open]:opacity-100 data-[open]:pointer-events-auto"
  >
    <slot />
  </div>
</div>

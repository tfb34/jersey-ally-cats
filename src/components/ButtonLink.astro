---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, variant = "primary", class: extraClasses } = Astro.props;

const variants = {
  primary: "bg-action-primary text-white hover:bg-action-primary-hover ",
  secondary:
    "bg-action-secondary text-brand-primary border border-2 border-brand-primary hover:bg-action-secondary-hover",
};
---

<a
  href={href}
  class:list={[
    variants[variant],
    extraClasses,
    "rounded-full px-3.5 py-2.5 text-sm font-semibold shadow-xs mt-3 md:mt-0 text-center",
  ]}
>
  <slot />
</a>
